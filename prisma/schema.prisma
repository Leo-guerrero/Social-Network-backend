// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String   
  score     Int @default(0)
  createdAt DateTime @default(now())
  profileURL String @default("DefualtNoImageProfile.png")

  profile   profiles?
  posts      posts[]

  likes     likes[]

  followers Follows[] @relation("UserFollowers")
  following Follows[] @relation("UserFollowing")

  solvedProblems SolvedProblems[]

  receivedNotifications notifications[] @relation("NotificationRecipient")
  notifications notifications[] @relation("NotificationSender")

  conversationParticipants ConversationParticipant[]
  sentMessages messages[]

}


model profiles {
  userid    Int    @id
  bio       String?

  user      users    @relation(fields: [userid], references: [id], onDelete: Cascade)
}


model posts {
  id        Int       @id @default(autoincrement()) 
  userid    Int   
  text      String?
  createdAt DateTime @default(now())
  likedByUser Boolean @default(false)
  imageURL String @default("")

  poster    users   @relation(fields: [userid], references: [id], onDelete: Cascade) 
  likes     likes[] 

  //replies section
  parentId Int? //this is nullable so we can check if is or is not null original post

    //the post this belongs to if this is a reply
    //"PostReplies" is the name of the relation
  parent posts? @relation("PostReplies", fields: [parentId], references: [id])
    //all replies to this post
  replies posts[] @relation("PostReplies")
}

model likes {
  id        Int       @id @default(autoincrement())
  userid    Int
  postid    Int 
  createdAt   DateTime @default(now())

  user      users  @relation(fields: [userid], references: [id], onDelete: Cascade)
  post      posts  @relation(fields: [postid], references: [id], onDelete: Cascade)

  @@unique([userid, postid])
}

model problems {
  id        Int       @id @default(autoincrement())
  userid    Int
  name      String @default("")
  difficulty  String @default("Easy")
  desc      String @default("")
  startCode String @default("")
  testCaseCode String @default("")

  answers   answers[]
  questions questions[]

  solvedProblems SolvedProblems[]
}

model questions {
  id Int @id @default(autoincrement())
  problemId Int
  questionOrder Int //0 - 2 CURRENTLY
  daQuestion String @default("")
  problem   problems @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model answers {
  id          Int       @id @default(autoincrement())
  problemId   Int       
  daAnswer    String    @default("")
  answerOrder Int //CURRENTLY from 0 - 5
  problem     problems  @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Follows {
  id         Int   @id @default(autoincrement())
  followerId Int
  followingId Int

  follower   users  @relation("UserFollowing", fields: [followerId], references: [id])
  following  users  @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId]) // prevents duplicates
}

model SolvedProblems {
  id        Int @id @default(autoincrement())
  userid    Int
  problemid Int
  numSolved Int @default(0)
  currentUserCode String @default("")
  createdAt DateTime @default(now())

  problem   problems  @relation(fields: [problemid], references: [id], onDelete: Cascade)
  solver    users   @relation(fields: [userid], references: [id], onDelete: Cascade)
}

model notifications {
  id          Int       @id @default(autoincrement())
  userId      Int                    // who receives it
  senderId    Int?                   // who triggered it (like a follow or like)
  type        String                 // "like", "follow", "reply", "message", etc.
  message     String                 // readable description
  targetPostId Int?                  // optional reference to posts
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // user        users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  user users @relation("NotificationRecipient", fields: [userId], references: [id])
  sender      users?    @relation("NotificationSender", fields: [senderId], references: [id])
}

model conversations {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())

  participants ConversationParticipant[]
  messages    messages[]
}

model ConversationParticipant {
  id            Int       @id @default(autoincrement())
  conversationId Int
  userId        Int

  conversation  conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user          users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model messages {
  id            Int       @id @default(autoincrement())
  conversationId Int
  senderId      Int
  content       String
  createdAt     DateTime @default(now())

  conversation conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       users        @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
